<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="cctv_config.php" />
          <add segment="data" />
          <add segment="tmp" />
          <add segment="output" />
          <add segment="notes" />
          <add segment="backups" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".dist" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <remove name="X-Frame-Options" />
        <remove name="Referrer-Policy" />
        <remove name="Permissions-Policy" />
        <remove name="Content-Security-Policy" />
        <remove name="Strict-Transport-Security" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(self), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="DemoSolar ERP Block Private Runtime Paths" stopProcessing="true">
          <match url="^(data|tmp|output|notes|backups)(/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Private ERP path" />
        </rule>
        <rule name="DemoSolar ERP Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^erp\.example\.test(?::[0-9]+)?$" ignoreCase="true" />
            <add input="{HTTPS}" pattern="^off$" ignoreCase="true" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Redirect" url="https://erp.example.test/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="DemoSolar COSEC Attendance Receiver" stopProcessing="true">
          <match url="^backend/cosec-event/([A-Za-z0-9_-]{24,128})/?$" />
          <action type="Rewrite" url="backend/cosec_event.php?receiver_key={R:1}" appendQueryString="true" />
        </rule>
        <rule name="DemoSolar CCTV HLS Redirect Compatibility" stopProcessing="true">
          <match url="^(nvr[0-9]+_c[0-9]+_(sub|main)|play[0-9]+_c[0-9]+_b[0-9]+_e[0-9]+)/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8888/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="DemoSolar CCTV HLS Gateway" stopProcessing="true">
          <match url="^cctv-stream/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:8888/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
